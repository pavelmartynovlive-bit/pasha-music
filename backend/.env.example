# СКОПИРУЙ этот файл в .env
PORT=8787
HOST=0.0.0.0

# VK web-session cookies.
# НЕ коммить .env в GitHub.
VK_COOKIE_P=
VK_COOKIE_REMIXSID=

# Сгенерируй длинный случайный ключ перед публикацией backend.
# PWA попросит его один раз и сохранит только на устройстве.
API_KEY=

# Пока можно оставить * для локальной проверки.
# Потом заменим на:
# https://pavelmartynovlive-bit.github.io
ALLOWED_ORIGIN=https://pavelmartynovlive-bit.github.io
